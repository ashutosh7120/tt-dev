{%- comment -%}AUTO-GENERATED — Studio-style carousel instance wrapper.{%- endcomment -%}

{%- if sai_state != 'draft' and sai_state != 'live' -%}
  <!-- SAI:WRAPPER:STATE_DEFAULT input={{ sai_state | default: 'NIL' }} fell_back_to=live -->
  {%- assign sai_state = 'live' -%}
{%- endif -%}

{%- if sai_state == 'draft' -%}
  {%- assign sai_handle = 'spectrum_snippet_tl3uqxjd_crsl001qi4n3w9ec2u3z6dj7yz_draft' -%}
{%- else -%}
  {%- assign sai_handle = 'spectrum_snippet_tl3uqxjd_crsl001qi4n3w9ec2u3z6dj7yz_live' -%}
{%- endif -%}

{%- assign sai_mo = metaobjects.spectrum_snippet_instance[sai_handle] -%}
{%- unless sai_mo -%}
  {%- paginate metaobjects.spectrum_snippet_instance.values by 250 -%}
    {%- for sai_entry in metaobjects.spectrum_snippet_instance.values -%}
      {%- if sai_entry.system.handle == sai_handle -%}
        {%- assign sai_mo = sai_entry -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endpaginate -%}
{%- endunless -%}

{%- if sai_mo and sai_mo.meta.value.status == 'active' -%}
  {%- assign sai_default = nil -%}
  {%- for sai_v in sai_mo.variants.value.variants -%}
    {%- if sai_v.isDefault -%}
      {%- assign sai_default = sai_v -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if sai_default -%}
    {%- capture sai_envelope -%}
    {
    "v":1,
    "instanceId":"crsl001qi4n3w9ec2u3z6dj7yz",
    "snippetId":"tl3uqxjd",
    "experienceId":"019e07ea-918e-7d5a-8cf5-01e635dcf5ad"
    ,"variants":{{ sai_mo.variants.value.variants | json }}
    ,"pools":{
    }
    }
    {%- endcapture -%}

    <style data-spectrum-style="crsl001qi4n3w9ec2u3z6dj7yz">
    {%- for sai_v in sai_mo.variants.value.variants -%}
      {%- if sai_v.css != blank -%}{{ sai_v.css }}{%- endif -%}
    {%- endfor -%}
    </style>
    <div data-spectrum-instance-id="crsl001qi4n3w9ec2u3z6dj7yz" data-spectrum-snippet-id="tl3uqxjd" data-spectrum-variant-id="{{ sai_default.variantId }}" data-spectrum-lq-snippet="mut-crsl001qi4n3w9ec2u3z6dj7yz" data-spectrum-experience="_system-158286807292" data-spectrum-feature-slug="announcement_bar">
      <script type="application/json" data-spectrum-envelope>{{ sai_envelope | replace: '</script>', '<\/script>' }}</script>
      {% render '_sai-snippet-tl3uqxjd', variant: sai_default, mo: sai_mo, mutation_handle: 'mut-crsl001qi4n3w9ec2u3z6dj7yz', experience_handle: '_system-158286807292' %}
    </div>
  {%- endif -%}
{%- endif -%}
