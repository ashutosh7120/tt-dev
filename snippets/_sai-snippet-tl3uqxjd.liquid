{%- comment -%}
  Announcement Bar - Carousel. Discrete-slide rotator with one slide visible
  at a time; transitions in/out on a timer or via prev/next chevrons and
  swipe gestures. Each slide is a self-contained unit (asset, two title
  blocks, CTA, timer) arranged in a 3-zone flex layout that re-centers when
  zones are absent.

  Wrapper contract:
    - variant            : default variant from mo.variants.value.variants
    - mo                 : spectrum_snippet_instance metaobject drop
    - mutation_handle    : 'mut-{instanceId}' (consumed by wrapper outer div)
    - experience_handle  : (consumed by wrapper outer div)

  variant.content fields:
    - auto_rotate            boolean Whether the carousel rotates on a timer.
    - rotation_seconds       number  Auto-rotate interval (3..60).
    - transition_type        string  'fade' | 'slide_push_horizontal' | 'slide_push_vertical'
    - transition_duration_ms number  Animation duration in ms (100..2000).
    - swipe_enabled          boolean Touch-gesture navigation, axis follows transition_type.
    - dismissable            boolean Show top-right close button; dismissal persists in sessionStorage keyed by bar-version.
    - asset_object_fit       string  'cover' | 'contain' | 'fill' | 'none'
    - asset_loop             boolean Maps to <video loop>; no-op for <img>.
    - promo_copied_text      string  Inline / toast feedback text for promo CTAs.
    - slides                 array   See "Slide field semantics" below.

  Slide field semantics:
    - background_color   string  Hex (#rrggbb / #rgb / #rrggbbaa). Defaults
                                 to opaque #ffffff when blank, transparent,
                                 or non-hex — a solid background eliminates
                                 cross-fade flicker between stacked slides.
    - redirect_url       string  Whole-slide click target. Skipped unless
                                 it starts with /, http://, https://,
                                 mailto:, or tel: (closes the
                                 javascript:/data: XSS surface).
    - asset_url          string  CDN URL. Render branches on the lowercased
                                 extension: .mp4 / .webm / .mov produce
                                 <video>; everything else produces <img>.
                                 Lowercased extension match avoids letting
                                 a .MP4 fall through to <img>.
    - title_1_text       string  Inline HTML allowed; rendered without
                                 | escape (rich text trust boundary equals
                                 theme settings).
    - title_2_text       string  Same as title_1_text.
    - cta_type           string  'redirect' | 'promo_code'.
    - cta_text           string  Button label. For promo_code it IS the
                                 literal code copied to clipboard. Empty
                                 cta_text suppresses the button entirely.
    - cta_url            string  Redirect target for cta_type='redirect'.
                                 Same URL allowlist as redirect_url. Empty
                                 / unsafe url with redirect type also
                                 suppresses the button.
    - cta_promo_feedback string  'toast' | 'inline_swap' | 'both'.
    - timer_end          string  ISO 8601 UTC. Skipped slide when expiry
                                 is 'hide_slide' AND timer_end is in the
                                 past at SSR — avoids the visible flash
                                 on initial paint.
    - timer_format       string  'DD:HH:MM:SS' | 'HH:MM:SS' | 'MM:SS'.
    - timer_expiry       string  'hide_slide' | 'hide_bar' | 'show_zeros'.

  Slide root element type swaps with CTA presence to keep HTML valid
  (<a> cannot contain interactive content):
    - With CTA → <div data-redirect-url="…"> + JS click handler
    - Without CTA → <a href="redirect_url">

  Slides without any displayable content (no asset, no titles, no CTA,
  no timer) are skipped. When the entire `slides` array is empty or
  collapsed to nothing, the snippet emits no markup at all.
{%- endcomment -%}

<script src="{{ 'sai-snippet-tl3uqxjd.js' | asset_url }}" async></script>

{%- assign content = variant.content -%}

{%- comment -%}── Bar-level boolean defaults: == nil, never | default: ──{%- endcomment -%}
{%- if content.swipe_enabled == nil -%}
  {%- assign swipe_enabled = true -%}
{%- else -%}
  {%- assign swipe_enabled = content.swipe_enabled -%}
{%- endif -%}

{%- if content.dismissable == nil -%}
  {%- assign dismissable = false -%}
{%- else -%}
  {%- assign dismissable = content.dismissable -%}
{%- endif -%}

{%- if content.asset_loop == nil -%}
  {%- assign asset_loop = true -%}
{%- else -%}
  {%- assign asset_loop = content.asset_loop -%}
{%- endif -%}

{%- if content.chevrons_enabled == nil -%}
  {%- assign chevrons_enabled = false -%}
{%- else -%}
  {%- assign chevrons_enabled = content.chevrons_enabled -%}
{%- endif -%}

{%- if content.auto_rotate == nil -%}
  {%- assign auto_rotate = true -%}
{%- else -%}
  {%- assign auto_rotate = content.auto_rotate -%}
{%- endif -%}

{%- comment -%}── Bar-level enum scrubbing — replace bogus values with sane defaults ──{%- endcomment -%}
{%- comment -%}
  `| times: 1` forces numeric coercion so a string-valued input (from a
  hand-edited JSON payload or a buggy Studio control) can't slip into the
  inline `style=` attribute. Then clamp to the schema bounds — meta.json
  declares min:3 max:60 here; the JS-side `_startRotation` clamps to 3 as
  a belt-and-braces second gate.
{%- endcomment -%}
{%- assign rotation_seconds = content.rotation_seconds | default: 5 | times: 1 -%}
{%- if rotation_seconds < 3 -%}{%- assign rotation_seconds = 3 -%}{%- endif -%}
{%- if rotation_seconds > 60 -%}{%- assign rotation_seconds = 60 -%}{%- endif -%}

{%- assign transition_type = content.transition_type | default: 'fade' -%}
{%- if transition_type != 'fade' and transition_type != 'slide_push_horizontal' and transition_type != 'slide_push_vertical' -%}
  {%- assign transition_type = 'fade' -%}
{%- endif -%}

{%- assign transition_duration_ms = content.transition_duration_ms | default: 400 | times: 1 -%}
{%- if transition_duration_ms < 100 -%}{%- assign transition_duration_ms = 100 -%}{%- endif -%}
{%- if transition_duration_ms > 2000 -%}{%- assign transition_duration_ms = 2000 -%}{%- endif -%}

{%- assign max_width = content.max_width | default: 0 | times: 1 -%}
{%- if max_width < 0 -%}{%- assign max_width = 0 -%}{%- endif -%}
{%- if max_width > 2000 -%}{%- assign max_width = 2000 -%}{%- endif -%}

{%- assign max_height = content.max_height | default: 0 | times: 1 -%}
{%- if max_height < 0 -%}{%- assign max_height = 0 -%}{%- endif -%}
{%- if max_height > 400 -%}{%- assign max_height = 400 -%}{%- endif -%}

{%- assign asset_object_fit = content.asset_object_fit | default: 'cover' -%}
{%- if asset_object_fit != 'cover' and asset_object_fit != 'contain' and asset_object_fit != 'fill' and asset_object_fit != 'none' -%}
  {%- assign asset_object_fit = 'cover' -%}
{%- endif -%}

{%- assign promo_copied_text = content.promo_copied_text | default: 'Code copied!' -%}

{%- comment -%}── Slide capture loop ──{%- endcomment -%}
{%- assign rendered_count = 0 -%}
{%- assign now_unix = 'now' | date: '%s' -%}

{%- capture slides_html -%}
  {%- if content.slides -%}
    {%- for slide in content.slides -%}
      {%- assign asset_url = slide.asset_url | default: '' -%}
      {%- assign asset_url_lower = asset_url | downcase -%}
      {%- assign slide_asset_size = slide.asset_size | default: 'thumbnail' -%}
      {%- if slide_asset_size != 'thumbnail' and slide_asset_size != 'full_width' -%}
        {%- assign slide_asset_size = 'thumbnail' -%}
      {%- endif -%}
      {%- assign title_1 = slide.title_1_text | default: '' -%}
      {%- assign title_2 = slide.title_2_text | default: '' -%}
      {%- assign cta_type = slide.cta_type | default: 'redirect' -%}
      {%- if cta_type != 'redirect' and cta_type != 'promo_code' -%}
        {%- assign cta_type = 'redirect' -%}
      {%- endif -%}
      {%- assign cta_text = slide.cta_text | default: '' -%}
      {%- assign cta_url_raw = slide.cta_url | default: '' -%}
      {%- assign redirect_url_raw = slide.redirect_url | default: '' -%}
      {%- assign cta_promo_feedback = slide.cta_promo_feedback | default: 'inline_swap' -%}
      {%- if cta_promo_feedback != 'toast' and cta_promo_feedback != 'inline_swap' and cta_promo_feedback != 'both' -%}
        {%- assign cta_promo_feedback = 'inline_swap' -%}
      {%- endif -%}
      {%- assign timer_end = slide.timer_end | default: '' -%}
      {%- assign timer_format = slide.timer_format | default: 'HH:MM:SS' -%}
      {%- if timer_format != 'DD:HH:MM:SS' and timer_format != 'HH:MM:SS' and timer_format != 'MM:SS' -%}
        {%- assign timer_format = 'HH:MM:SS' -%}
      {%- endif -%}
      {%- assign timer_expiry = slide.timer_expiry | default: 'show_zeros' -%}
      {%- if timer_expiry != 'hide_slide' and timer_expiry != 'hide_bar' and timer_expiry != 'show_zeros' -%}
        {%- assign timer_expiry = 'show_zeros' -%}
      {%- endif -%}

      {%- comment -%} Skip already-expired hide_slide slides at SSR. {%- endcomment -%}
      {%- if timer_end != '' and timer_expiry == 'hide_slide' -%}
        {%- assign timer_end_unix = timer_end | date: '%s' -%}
        {%- if timer_end_unix and timer_end_unix < now_unix -%}
          {%- continue -%}
        {%- endif -%}
      {%- endif -%}

      {%- comment -%}
        URL allowlist — same-origin / | http:// | https:// | mailto: | tel:.
        The `r2` check rejects protocol-relative URLs like `//evil.com` that
        browsers resolve to the page's protocol — those would silently
        navigate visitors off-site even though everything else in this block
        is closing the click-XSS / phishing surface.
      {%- endcomment -%}
      {%- assign redirect_url_safe = '' -%}
      {%- if redirect_url_raw != '' -%}
        {%- assign r1 = redirect_url_raw | slice: 0, 1 -%}
        {%- assign r2 = redirect_url_raw | slice: 0, 2 -%}
        {%- assign r4 = redirect_url_raw | slice: 0, 4 -%}
        {%- assign r7 = redirect_url_raw | slice: 0, 7 -%}
        {%- assign r8 = redirect_url_raw | slice: 0, 8 -%}
        {%- if r2 != '//' -%}
          {%- if r1 == '/' or r4 == 'tel:' or r7 == 'mailto:' or r7 == 'http://' or r8 == 'https://' -%}
            {%- assign redirect_url_safe = redirect_url_raw -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}

      {%- assign cta_url_safe = '' -%}
      {%- if cta_url_raw != '' -%}
        {%- assign c1 = cta_url_raw | slice: 0, 1 -%}
        {%- assign c2 = cta_url_raw | slice: 0, 2 -%}
        {%- assign c4 = cta_url_raw | slice: 0, 4 -%}
        {%- assign c7 = cta_url_raw | slice: 0, 7 -%}
        {%- assign c8 = cta_url_raw | slice: 0, 8 -%}
        {%- if c2 != '//' -%}
          {%- if c1 == '/' or c4 == 'tel:' or c7 == 'mailto:' or c7 == 'http://' or c8 == 'https://' -%}
            {%- assign cta_url_safe = cta_url_raw -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}

      {%- comment -%}
        Asset URL allowlist — same shape as redirect/cta. `<img src>` and
        `<video src>` happily fire requests to attacker-controlled origins
        (`//evil.com/leak.png`) without execution, but that's still the
        same off-site surface the redirect allowlist closes. `data:` and
        `javascript:` URLs are also filtered out. Asset zone is suppressed
        entirely when the URL doesn't pass.
      {%- endcomment -%}
      {%- assign asset_url_safe = '' -%}
      {%- if asset_url != '' -%}
        {%- assign a1 = asset_url | slice: 0, 1 -%}
        {%- assign a2 = asset_url | slice: 0, 2 -%}
        {%- assign a7 = asset_url | slice: 0, 7 -%}
        {%- assign a8 = asset_url | slice: 0, 8 -%}
        {%- if a2 != '//' -%}
          {%- if a1 == '/' or a7 == 'http://' or a8 == 'https://' -%}
            {%- assign asset_url_safe = asset_url -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}

      {%- comment -%}
        Whether the CTA actually renders. Empty cta_text suppresses; redirect
        type without a safe url also suppresses (no destination = no button).
      {%- endcomment -%}
      {%- assign has_cta = false -%}
      {%- if cta_text != '' -%}
        {%- if cta_type == 'promo_code' -%}
          {%- assign has_cta = true -%}
        {%- elsif cta_type == 'redirect' and cta_url_safe != '' -%}
          {%- assign has_cta = true -%}
        {%- endif -%}
      {%- endif -%}

      {%- assign has_titles = false -%}
      {%- if title_1 != '' or title_2 != '' -%}
        {%- assign has_titles = true -%}
      {%- endif -%}

      {%- assign has_actions = false -%}
      {%- if has_cta or timer_end != '' -%}
        {%- assign has_actions = true -%}
      {%- endif -%}

      {%- comment -%} Skip slides with nothing displayable at all. {%- endcomment -%}
      {%- if asset_url_safe == '' and has_titles == false and has_actions == false -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign current_index = rendered_count -%}
      {%- assign rendered_count = rendered_count | plus: 1 -%}

      {%- assign initial_state = 'hidden' -%}
      {%- if current_index == 0 -%}
        {%- assign initial_state = 'current' -%}
      {%- endif -%}

      {%- comment -%} Layout-collapse modifier classes (drives the 7-rule matrix). {%- endcomment -%}
      {%- assign mod_class = '' -%}
      {%- if asset_url_safe != '' -%}{%- assign mod_class = mod_class | append: ' sai-tl3uqxjd__slide--has-asset' -%}{%- endif -%}
      {%- if title_1 != '' -%}{%- assign mod_class = mod_class | append: ' sai-tl3uqxjd__slide--has-title-1' -%}{%- endif -%}
      {%- if title_2 != '' -%}{%- assign mod_class = mod_class | append: ' sai-tl3uqxjd__slide--has-title-2' -%}{%- endif -%}
      {%- if has_titles -%}{%- assign mod_class = mod_class | append: ' sai-tl3uqxjd__slide--has-titles' -%}{%- endif -%}
      {%- if has_cta -%}{%- assign mod_class = mod_class | append: ' sai-tl3uqxjd__slide--has-cta' -%}{%- endif -%}
      {%- if timer_end != '' -%}{%- assign mod_class = mod_class | append: ' sai-tl3uqxjd__slide--has-timer' -%}{%- endif -%}
      {%- if has_actions -%}{%- assign mod_class = mod_class | append: ' sai-tl3uqxjd__slide--has-actions' -%}{%- endif -%}
      {%- if slide_asset_size == 'full_width' -%}{%- assign mod_class = mod_class | append: ' sai-tl3uqxjd__slide--asset-full-width' -%}{%- endif -%}

      {%- comment -%}
        Strict hex validation. The earlier weaker check (`bg_first == '#'`)
        let attacks like `#ff0000;}body{...}` through — `| escape` does not
        touch `;`, `{`, `}`, so they survived into the inline `style="…"`
        attribute and injected CSS. Walk the body char-by-char and reject
        anything outside [0-9a-f]; require length 3/4/6/8 (rgb / rgba /
        rrggbb / rrggbbaa). Defaults to opaque white to eliminate cross-fade
        midpoint flicker, also covers missing / transparent / malformed.
      {%- endcomment -%}
      {%- assign slide_bg_raw = slide.background_color | default: '' -%}
      {%- assign bg_first = slide_bg_raw | slice: 0, 1 -%}
      {%- assign bg_body = slide_bg_raw | slice: 1, 100 | downcase -%}
      {%- assign bg_body_len = bg_body | size -%}
      {%- assign bg_valid = false -%}
      {%- if bg_first == '#' -%}
        {%- if bg_body_len == 3 or bg_body_len == 4 or bg_body_len == 6 or bg_body_len == 8 -%}
          {%- assign bg_valid = true -%}
          {%- assign hex_chars = '0123456789abcdef' -%}
          {%- for i in (0..7) -%}
            {%- if i >= bg_body_len -%}
              {%- break -%}
            {%- endif -%}
            {%- assign ch = bg_body | slice: i, 1 -%}
            {%- unless hex_chars contains ch -%}
              {%- assign bg_valid = false -%}
              {%- break -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
      {%- if bg_valid -%}
        {%- assign slide_bg = '#' | append: bg_body -%}
      {%- else -%}
        {%- assign slide_bg = '#ffffff' -%}
      {%- endif -%}

      {%- comment -%}
        Real-extension check (matches the ticker pattern): strip the query
        string and hash, then take the last dot-segment of the path. A bare
        `contains` substring match misroutes URLs whose query string or path
        incidentally contains '.mp4' / '.webm' / '.mov' (e.g.
        `cdn.example.com/foo.jpg?ref=video.mp4`).
      {%- endcomment -%}
      {%- assign asset_path = asset_url_lower | split: '?' | first | split: '#' | first -%}
      {%- assign asset_ext = asset_path | split: '.' | last -%}
      {%- assign is_video = false -%}
      {%- if asset_ext == 'mp4' or asset_ext == 'webm' or asset_ext == 'mov' -%}
        {%- assign is_video = true -%}
      {%- endif -%}

      {%- comment -%}
        aria-label string for live-region announcement on manual nav. Strip
        HTML before storing so screen readers don't read tag soup. Falls back
        to title_2 when title_1 is empty.
      {%- endcomment -%}
      {%- comment -%}
        Order matters: strip_html → truncate → escape. Truncating AFTER
        escape can cut mid-entity (e.g. `Bath &amp; Body` truncated at 8
        chars → `Bath &am...`), which corrupts the resulting HTML attribute.
        Truncate on the raw text, THEN escape the trimmed result cleanly.
      {%- endcomment -%}
      {%- assign aria_label = title_1 | strip_html | truncate: 80 | escape -%}
      {%- if aria_label == '' -%}
        {%- assign aria_label = title_2 | strip_html | truncate: 80 | escape -%}
      {%- endif -%}

      {%- comment -%}
        Slide id is intentionally omitted — nothing in the JS, CSS, or
        aria wiring references it, and a static `id` collides when the
        same snippet is dropped multiple times on a single page (each
        instance would emit `sai-tl3uqxjd-slide-0`, breaking HTML
        validity). Use `data-slide-index` + `:scope`-scoped selectors
        inside the host for any positional lookup.
      {%- endcomment -%}
      {%- if has_cta -%}
        <div class="sai-tl3uqxjd__slide{{ mod_class }}"
             role="group"
             aria-roledescription="slide"
             aria-label="Slide {{ rendered_count }}"
             data-slide-index="{{ current_index }}"
             data-state="{{ initial_state }}"
             data-aria-label="{{ aria_label }}"
             {%- if redirect_url_safe != '' %} data-redirect-url="{{ redirect_url_safe | escape }}"{% endif %}
             {%- if initial_state == 'hidden' %} inert{% endif %}
             style="--sai-slide-bg: {{ slide_bg | escape }};">
      {%- else -%}
        <a class="sai-tl3uqxjd__slide{{ mod_class }}"
           role="group"
           aria-roledescription="slide"
           aria-label="Slide {{ rendered_count }}"
           data-slide-index="{{ current_index }}"
           data-state="{{ initial_state }}"
           data-aria-label="{{ aria_label }}"
           {%- if redirect_url_safe != '' %} href="{{ redirect_url_safe | escape }}"{% else %} aria-disabled="true"{% endif %}
           {%- if initial_state == 'hidden' %} inert{% endif %}
           style="--sai-slide-bg: {{ slide_bg | escape }};">
      {%- endif -%}

        {%- if asset_url_safe != '' -%}
          <div class="sai-tl3uqxjd__zone-asset">
            {%- if is_video -%}
              {%- comment -%}
                preload="none" + no autoplay at SSR: JS flips preload to
                "auto" and calls play() only on the current slide (and
                pauses + restores "none" on the rest in _setVideoPlayState).
                A carousel with 18 slides * autoplay would otherwise warm
                up 18 video buffers above the fold and tank LCP on slow
                connections; this contains the cost to one buffer at a
                time. `muted playsinline` keep autoplay-policy compliance
                for the JS-driven .play() call.
              {%- endcomment -%}
              <video class="sai-tl3uqxjd__asset"
                     src="{{ asset_url_safe | escape }}"
                     preload="none" muted playsinline
                     {%- if asset_loop %} loop{% endif %}
                     data-object-fit="{{ asset_object_fit | escape }}"></video>
            {%- else -%}
              <img class="sai-tl3uqxjd__asset"
                   src="{{ asset_url_safe | escape }}"
                   loading="lazy"
                   data-object-fit="{{ asset_object_fit | escape }}"
                   alt="{{ aria_label }}">
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if has_titles -%}
          <div class="sai-tl3uqxjd__zone-titles">
            {%- if title_1 != '' -%}
              <span class="sai-tl3uqxjd__title-1">{{ title_1 }}</span>
            {%- endif -%}
            {%- if title_2 != '' -%}
              <span class="sai-tl3uqxjd__title-2">{{ title_2 }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if has_actions -%}
          <div class="sai-tl3uqxjd__zone-actions">
            {%- if timer_end != '' -%}
              <span class="sai-tl3uqxjd__timer"
                    data-timer-end="{{ timer_end | escape }}"
                    data-timer-format="{{ timer_format | escape }}"
                    data-timer-expiry="{{ timer_expiry | escape }}"
                    aria-live="off"></span>
            {%- endif -%}

            {%- if has_cta -%}
              <button type="button"
                      class="sai-tl3uqxjd__cta"
                      data-cta-type="{{ cta_type | escape }}"
                      data-slide-index="{{ current_index }}"
                      {%- if cta_type == 'redirect' %} data-cta-url="{{ cta_url_safe | escape }}"{% endif -%}
                      {%- comment -%}
                        For promo_code CTAs, bake the actual code into a
                        stable attribute. The button's text content is
                        mutated to "Code copied!" for 2s on click — reading
                        the code back from textContent would pick up that
                        feedback string on a re-click within the window.
                      {%- endcomment -%}
                      {%- if cta_type == 'promo_code' %} data-promo-feedback="{{ cta_promo_feedback | escape }}" data-promo-code="{{ cta_text | escape }}"{% endif %}>{{ cta_text | escape }}</button>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- if has_cta -%}
        </div>
      {%- else -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if rendered_count > 0 -%}
  {%- assign single_slide = false -%}
  {%- if rendered_count == 1 -%}
    {%- assign single_slide = true -%}
  {%- endif -%}

  {%- assign slides_warn = false -%}
  {%- if content.slides.size > 20 -%}
    {%- assign slides_warn = true -%}
    {%- comment -%}
      Soft cap: > 20 slides is almost certainly a misconfiguration. The bar
      remains usable; JS emits console.warn once for visibility.
    {%- endcomment -%}
  {%- endif -%}

  {%- assign bar_version = content.slides | json | sha256 -%}

<sai-tl3uqxjd
  class="sai-tl3uqxjd{% if single_slide %} sai-tl3uqxjd--single{% endif %} sai-tl3uqxjd--transition-{{ transition_type }}"
  data-auto-rotate="{% if auto_rotate %}true{% else %}false{% endif %}"
  data-rotation-seconds="{{ rotation_seconds }}"
  data-transition-type="{{ transition_type | escape }}"
  data-transition-duration-ms="{{ transition_duration_ms }}"
  data-swipe-enabled="{% if swipe_enabled %}true{% else %}false{% endif %}"
  data-dismissable="{% if dismissable %}true{% else %}false{% endif %}"
  data-max-width="{{ max_width }}"
  data-max-height="{{ max_height }}"
  data-asset-object-fit="{{ asset_object_fit | escape }}"
  data-asset-loop="{% if asset_loop %}true{% else %}false{% endif %}"
  data-promo-copied-text="{{ promo_copied_text | escape }}"
  data-chevrons-enabled="{% if chevrons_enabled %}true{% else %}false{% endif %}"
  data-bar-version="{{ bar_version }}"
  data-rendered-count="{{ rendered_count }}"
  data-single-slide="{% if single_slide %}true{% else %}false{% endif %}"
  data-slides-warn="{% if slides_warn %}true{% else %}false{% endif %}"
  style="--sai-tl3uqxjd-transition-duration: {{ transition_duration_ms }}ms;{% if max_width > 0 %} --sai-tl3uqxjd-max-width: {{ max_width }}px;{% endif %}{% if max_height > 0 %} --sai-tl3uqxjd-max-height: {{ max_height }}px;{% endif %}"
  role="region"
  aria-roledescription="carousel"
  aria-label="Announcement bar"
>
  <div class="sai-tl3uqxjd__rail">{{ slides_html }}</div>

  {%- if dismissable -%}
    <button type="button" class="sai-tl3uqxjd__close" aria-label="Dismiss announcement">×</button>
  {%- endif -%}

  {%- if chevrons_enabled and single_slide == false -%}
    <button type="button" class="sai-tl3uqxjd__chev sai-tl3uqxjd__chev--prev" aria-label="Previous slide" data-chev="prev">‹</button>
    <button type="button" class="sai-tl3uqxjd__chev sai-tl3uqxjd__chev--next" aria-label="Next slide" data-chev="next">›</button>
  {%- endif -%}

  <div class="sai-tl3uqxjd__live" aria-live="polite" aria-atomic="true"></div>
</sai-tl3uqxjd>
{%- endif -%}
