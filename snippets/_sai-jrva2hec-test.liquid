<div data-spectrum-instance-id="test-jrva2hec"
     data-spectrum-snippet-id="jrva2hec"
     data-spectrum-experience="test-experience"
     data-spectrum-feature-slug="announcement_bar">
  <sai-jrva2hec class="sai-jrva2hec" data-ticker-seconds="30" data-pause-on-hover="true" data-rendered-count="14" aria-roledescription="ticker" aria-label="Announcement bar">
    <div class="sai-jrva2hec__viewport">
      <div class="sai-jrva2hec__track" data-pause-on-hover="true">
        <div class="sai-jrva2hec__track-copy" aria-hidden="false">{{ slides_html }}</div>
